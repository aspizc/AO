  "workflows": {
    "plan": {
      "promptId": "orchestrator.plan.v1",
      "instruction": "Create a trace, assign a planner, and persist a typed plan artifact before execution.",
      "tools": [
        "orchestration.create",
        "orchestration.view",
        "task.assign",
        "agent.spawn",
        "agent.ask",
        "agent.view",
        "artifact.put",
        "artifact.list"
      ],
      "artifacts": ["plan", "summary"],
      "prerequisites": []
    },
    "execute": {
      "promptId": "orchestrator.execute.v1",
      "instruction": "Delegate bounded implementation and testing through assigned agents and typed artifacts.",
      "tools": [
        "task.assign",
        "agent.delegate",
        "agent.spawn",
        "agent.ask",
        "agent.view",
        "agent.kill",
        "artifact.put",
        "artifact.list",
        "artifact.share"
      ],
      "artifacts": ["raw_diff", "test_report", "summary"],
      "prerequisites": []
    },
    "coordinate": {
      "promptId": "orchestrator.coordinate.v1",
      "instruction": "Coordinate participants through typed messages while preserving trace and scope boundaries.",
      "tools": [
        "coordination.status",
        "coordination.register",
        "coordination.heartbeat",
        "coordination.discover",
        "coordination.unregister",
        "coordination.send",
        "coordination.receive",
        "coordination.ack",
        "message.send",
        "message.list",
        "message.reply"
      ],
      "artifacts": ["summary"],
      "prerequisites": []
    },
    "review": {
      "promptId": "orchestrator.review.v1",
      "instruction": "Collect typed test and review artifacts without treating the unavailable review gate as implemented.",
      "tools": [
        "task.assign",
        "agent.delegate",
        "agent.spawn",
        "agent.ask",
        "agent.view",
        "artifact.put",
        "artifact.get",
        "artifact.list",
        "artifact.share"
      ],
      "artifacts": ["review_notes", "test_report", "security_finding", "summary"],
      "prerequisites": ["F/0/03"]
    },
    "recovery": {
      "promptId": "orchestrator.recovery.v1",
      "instruction": "Inspect state, record intervention evidence, and resume or cancel without duplicating work.",
      "tools": [
        "orchestration.view",
        "orchestration.pause",
        "orchestration.resume",
        "orchestration.cancel",
        "agent.view",
        "agent.kill",
        "artifact.put",
        "artifact.list",
        "session.attach_info",
        "session.intervention_note"
      ],
      "artifacts": ["raw_stacktrace", "test_report", "summary"],
      "prerequisites": []
    },
    "completion": {
      "promptId": "orchestrator.completion.v1",
      "instruction": "Check typed evidence and keep completion blocked until the unavailable completion integration exists.",
      "tools": [
        "orchestration.view",
        "orchestration.complete",
        "artifact.get",
        "artifact.list",
        "approval.poll",
        "approval.wait"
      ],
      "artifacts": ["review_notes", "test_report", "summary"],
      "prerequisites": ["F/0/04"]
    }
  },
