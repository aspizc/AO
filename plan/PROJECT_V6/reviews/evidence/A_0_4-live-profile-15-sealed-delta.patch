+      if (key === "target") spawn.pane.target = "%2";
+      const fx = adapterHarness(frames(), spawn);
+      await assert.rejects(fx.ask, uncertain);
+      assert.deepEqual(fx.inputs, [`\x1b[200~${measured.prompt}\x1b[201~`, "\r"]);
