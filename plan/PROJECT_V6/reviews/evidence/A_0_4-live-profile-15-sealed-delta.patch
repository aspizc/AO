+
+for (const measured of [profile, delayedProfile]) {
+  const version = measured === profile ? "2.1.293" : "2.1.294";
+  const frames = () => clone([measured.ready, measured.postPaste, measured.guard, measured.after]);
+  const spawnFrame = () => {
+    const frame = clone(measured.ready);
+    // Spawn observation is valid at 80x24; only first-ask frames carry the measured layout.
+    Object.assign(frame.pane, { width: 80, height: 24, cursor: 20 });
+    Object.assign(frame.submitState, { width: "80", height: "24" });
+    const rows = Array(24).fill("");
+    const readyRows = measured.ready.snapshot.split("\n");
+    rows.splice(0, 4, ...readyRows.slice(0, 4));
+    rows[19] = rows[21] = "─".repeat(80);
+    rows[20] = readyRows[36];
+    rows[22] = readyRows[38];
+    rows[23] = readyRows[39];
+    frame.snapshot = rows.join("\n") + "\n";
+    return frame;
+  };
+  const adapterHarness = (records, spawn = spawnFrame()) => {
+    const fx = harness([spawn, ...records]);
+    const adapter = new BaseAdapter({ id: "claude-code", config: {} });
+    adapter.rememberFreshClaudeSpawn({ tmuxTarget: "%1", run: fx.run });
+    return { ...fx, ask: () => adapter.submitPrompt({ ...fx.options, prompt: measured.prompt }) };
+  };
+
+  test(`trial15 ${version} same-process pre-ask resize accepts the first completed reply with one Enter`, async () => {
+    const fx = adapterHarness(frames());
