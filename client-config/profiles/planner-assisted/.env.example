# Planner-assisted profile for agents-gateway.
#
# AGENTS_REPO_ROOTS must be the absolute path to this agents-orchestrator
# checkout. Example:
# AGENTS_REPO_ROOTS=/home/me/git/agents-orchestrator
#
# Default model selection comes from the base registry:
# - planner: claude-code, role planner, claude-opus-5-5, effort max
# - apply coder: claude-code, role coder, claude-opus-5-5, effort max
#
# Keep AGENTS_DRY_RUN=1 for rehearsal. Set AGENTS_DRY_RUN=0 only after creating
# a dedicated branch for plan changes and confirming Claude CLI login.

AGENTS_WORKSPACE=./workspace
AGENTS_POLICIES_DIR=./policies
AGENTS_DRY_RUN=1
AGENTS_REPO_ROOTS=REPLACE_WITH_ABSOLUTE_AGENTS_ORCHESTRATOR_PATH
AGENTS_CLAUDE_BIN=claude

# Optional bounded autonomous mode. Leave empty for human approval.
# Use plan.apply to auto-grant only the planning-loop apply gate.
# Protected pushes, dependency changes, protected branch writes, and restricted
# contexts always require a human decision.
AGENTS_AUTOAPPROVE=
# Example:
# AGENTS_AUTOAPPROVE=plan.apply
