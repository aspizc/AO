# MVP2.0 two-agent Gateway profile.
# Load these variables in the MCP host environment or copy them into the host's
# MCP server env block.

# Runtime state, audit, artifacts, and message access secret file live here.
AGENTS_WORKSPACE=./workspace

# Base policy registry. Codex is enabled by default and policy-gated per repo.
AGENTS_POLICIES_DIR=./policies

# Real mode. For a safe rehearsal before using real CLIs, temporarily set:
# AGENTS_DRY_RUN=1
AGENTS_DRY_RUN=0

# Required: absolute path allowlist for agent cwd values.
# Use a colon-separated list when allowing more than one repository root.
AGENTS_REPO_ROOTS=REPLACE_WITH_ABSOLUTE_WORK_REPO_PATH

# Real CLI binaries. Override when the binaries are not on PATH.
AGENTS_CLAUDE_BIN=claude
AGENTS_CODEX_BIN=codex

# Codex sandbox used for both headless and supervised execution.
AGENTS_CODEX_SANDBOX=workspace-write

# Optional bounded autonomous mode. Leave empty for human approval.
# Use code.apply to auto-grant only the post-review acceptance gate.
# Protected pushes, dependency changes, protected branch writes, and restricted
# contexts always require a human decision.
AGENTS_AUTOAPPROVE=
# Example:
# AGENTS_AUTOAPPROVE=code.apply

# Model defaults come from policies/; the MVP2 flow requests them explicitly:
# - Codex coder: gpt-5.6-sol with max effort and priority (Fast) service tier.
# - Claude reviewer: claude-fable-5 with max effort.
