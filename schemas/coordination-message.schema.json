{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agents-orchestrator.local/schemas/coordination-message.schema.json",
  "version": 1,
  "title": "Coordination message",
  "description": "Addressed coordination-plane message envelope. Delivery metadata is added by receive operations and is not part of the persisted envelope.",
  "type": "object",
  "required": [
    "protocolVersion",
    "messageId",
    "fromParticipantId",
    "toParticipantId",
    "scopeId",
    "messageType",
    "classification",
    "body",
    "createdAt"
  ],
  "additionalProperties": false,
  "properties": {
    "protocolVersion": {
      "const": 1
    },
    "messageId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "fromParticipantId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "toParticipantId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "scopeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "messageType": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "classification": {
      "enum": ["unrestricted", "internal"]
    },
    "body": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "traceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "correlationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "replyToMessageId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    }
  }
}
