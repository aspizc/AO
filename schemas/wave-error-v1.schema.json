{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agents-orchestrator.local/schemas/wave-error-v1.schema.json",
  "title": "Safe local wave error",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "outcomeCode"],
  "properties": {
    "schemaVersion": {"const": "wave-error/v1"},
    "outcomeCode": {"type": "string", "maxLength": 64, "pattern": "^[A-Z][A-Z0-9_]{0,63}(?![\\s\\S])"},
    "field": {"$ref": "#/$defs/schemaId"},
    "resource": {"$ref": "#/$defs/schemaId"},
    "taskId": {"$ref": "#/$defs/localId"},
    "runId": {"$ref": "#/$defs/localId"},
    "counters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["limit", "used", "requested"],
      "properties": {
        "limit": {"type": "integer", "minimum": 0},
        "used": {"type": "integer", "minimum": 0},
        "requested": {"type": "integer", "minimum": 0}
      }
    }
  },
  "$defs": {
    "schemaId": {"type": "string", "maxLength": 64, "pattern": "^[A-Za-z][A-Za-z0-9]{0,63}(?![\\s\\S])"},
    "localId": {"type": "string", "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}(?![\\s\\S])"}
  }
}
