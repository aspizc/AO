{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agents-orchestrator.local/schemas/doctor-profile-v1.schema.json",
  "title": "Doctor input profile",
  "type": "object",
  "required": [
    "$schema",
    "schemaVersion",
    "profileId",
    "repository",
    "plan",
    "selections"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "const": "doctor-profile/v1"
    },
    "profileId": {
      "const": "canonical-orchestrator"
    },
    "repository": {
      "$ref": "#/$defs/relativePath"
    },
    "plan": {
      "$ref": "#/$defs/relativePath"
    },
    "selections": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/selection"
      }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))(?:[A-Za-z0-9._-]+/)*[A-Za-z0-9._-]+$"
    },
    "nullableString": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "selection": {
      "type": "object",
      "required": [
        "id",
        "phase",
        "agent",
        "role",
        "model",
        "reasoningEffort",
        "serviceTier",
        "tools"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "phase": {
          "type": "string",
          "minLength": 1
        },
        "agent": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "reasoningEffort": {
          "$ref": "#/$defs/nullableString"
        },
        "serviceTier": {
          "$ref": "#/$defs/nullableString"
        },
        "tools": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
